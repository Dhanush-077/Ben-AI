# Copy this file to .env and fill in your real keys. Never commit .env to GitHub.

# News API key — from newsapi.org (free tier) (required for news/current-affairs answers)
NEWS_API_KEY=your_newsapi_org_key_here
ALPHA_VANTAGE_KEY=your_alphavantage_key_here
GOOGLE_CSE_KEY=your_google_custom_search_key_here
GOOGLE_CSE_ID=your_google_custom_search_engine_id_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Google Gemini API (official generativelanguage.googleapis.com endpoint) — production chat provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
